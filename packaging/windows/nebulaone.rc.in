// Windows resources: the application icon and version information.
#include <winver.h>
IDI_ICON1 ICON "@NEBULA_ICO@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Josh McFerran"
      VALUE "FileDescription", "NebulaOne"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductName", "NebulaOne"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "OriginalFilename", "NebulaOne.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
