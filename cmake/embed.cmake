# Turns binary files into a C++ source with byte arrays.
# Usage: cmake -DOUT=out.cpp -DFILES="a;b;c" -P embed.cmake
# Each file becomes   extern const unsigned char embed_<name>[]; and a size.
# Look them up at runtime with nb::embedded("name.ext").
string(REPLACE "," ";" FILES "${FILES}")
set(src "// Generated by cmake/embed.cmake - do not edit.\n#include <cstddef>\n#include <cstring>\n\nnamespace nb {\nstruct EmbeddedFile { const char* name; const unsigned char* data; size_t size; };\n\n")
set(table "")
foreach(f ${FILES})
  get_filename_component(name ${f} NAME)
  string(MAKE_C_IDENTIFIER ${name} id)
  file(READ ${f} hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  # break long lines every 32 bytes
  string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
  string(APPEND src "static const unsigned char embed_${id}[${size}] = {\n${bytes}\n};\n")
  string(APPEND table "  {\"${name}\", embed_${id}, ${size}},\n")
endforeach()
string(APPEND src "\nstatic const EmbeddedFile kFiles[] = {\n${table}};\n\n")
string(APPEND src "const unsigned char* embedded(const char* name, size_t* size) {\n  for (const auto& f : kFiles)\n    if (std::strcmp(f.name, name) == 0) { if (size) *size = f.size; return f.data; }\n  if (size) *size = 0;\n  return nullptr;\n}\n}  // namespace nb\n")
file(WRITE ${OUT} "${src}")
